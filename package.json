{
  "name": "graphql-js-joda",
  "version": "1.0.0",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*\""
  },
  "description": "js-joda types for GraphQL",
  "repository": "https://github.com/cranberyxl/graphql-joda-types",
  "license": "MIT",
  "peerDependencies": {
    "@js-joda/core": "^5.0.0",
    "graphql": "^15.0.0 || ^16.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.9",
    "@eslint/js": "^9.36.0",
    "@js-joda/core": "^5.6.5",
    "@stylistic/eslint-plugin": "^5.4.0",
    "@swc/cli": "^0.7.7",
    "@swc/core": "^1.12.0",
    "@swc/jest": "^0.2.38",
    "@types/jest": "^27.0.1",
    "coveralls": "^3.0.1",
    "eslint": "^9.36.0",
    "eslint-config-airbnb-base": "^13.1.0",
    "eslint-config-airbnb-extended": "^1.0.11",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.4.3",
    "eslint-plugin-import": "^2.14.0",
    "eslint-plugin-import-x": "^4.15.1",
    "eslint-plugin-jest": "^21.25.0",
    "eslint-plugin-n": "^17.19.0",
    "eslint-plugin-prettier": "^5.4.1",
    "graphql": "16.10.0",
    "husky": "^7.0.1",
    "jest": "^29.7.0",
    "prettier": "3.6.2",
    "ts-jest": "^26.5.5",
    "tsup": "^8.5.0",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.44.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "packageManager": "yarn@4.10.0+sha256.2384c037cb81c4fa25062ce1c14b74a4a0933b3b90c2f99cdaa020dd476a95cc"
}
