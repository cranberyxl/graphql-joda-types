{
  "name": "graphql-js-joda",
  "version": "1.0.0",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*\""
  },
  "description": "js-joda types for GraphQL",
  "repository": "https://github.com/cranberyxl/graphql-joda-types",
  "license": "MIT",
  "peerDependencies": {
    "@js-joda/core": "^5.0.0",
    "graphql": "^15.0.0 || ^16.0.0"
  },
  "devDependencies": {
    "@js-joda/core": "^5.6.5",
    "@types/jest": "^27.0.1",
    "coveralls": "^3.0.1",
    "graphql": "16.10.0",
    "husky": "^7.0.1",
    "jest": "^26.6.3",
    "prettier": "3.6.2",
    "ts-jest": "^26.5.5",
    "tsup": "^8.5.0",
    "typescript": "5.6.3"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "packageManager": "yarn@4.10.0+sha256.2384c037cb81c4fa25062ce1c14b74a4a0933b3b90c2f99cdaa020dd476a95cc"
}
